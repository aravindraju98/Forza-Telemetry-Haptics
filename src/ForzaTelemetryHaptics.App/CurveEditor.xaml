<UserControl x:Class="ForzaTelemetryHaptics.App.CurveEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="220">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#0E0F10" BorderBrush="#2C2F33" BorderThickness="1">
            <Canvas x:Name="Plot"
                    ClipToBounds="True"
                    Background="Transparent"
                    MouseLeftButtonDown="Plot_MouseLeftButtonDown"
                    MouseMove="Plot_MouseMove"
                    MouseLeftButtonUp="Plot_MouseLeftButtonUp"
                    MouseRightButtonDown="Plot_MouseRightButtonDown"
                    SizeChanged="Plot_SizeChanged"/>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,6,0,0">
            <TextBlock x:Name="YLabel" DockPanel.Dock="Left" Foreground="#8A8880" FontSize="11" Text="Rumble"/>
            <TextBlock x:Name="XLabel" HorizontalAlignment="Right" Foreground="#8A8880" FontSize="11" Text="Input"/>
        </DockPanel>
    </Grid>
</UserControl>
